{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prismloop.local/schemas/app-case.v1.json",
  "title": "Prismloop APP Test Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "owner",
    "status",
    "priority",
    "design_ref",
    "environments",
    "preconditions",
    "steps",
    "assertions",
    "evidence_required",
    "teardown"
  ],
  "properties": {
    "schema_version": {"const": "prismloop.app-case.v1"},
    "case_id": {"type": "string", "pattern": "^APP-[A-Z0-9][A-Z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 3, "maxLength": 200},
    "owner": {"const": "app-test"},
    "status": {"enum": ["draft", "review", "approved", "active", "deprecated", "retired"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "design_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figma_url", "version", "node_ids"],
      "properties": {
        "figma_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "version": {"type": "string", "minLength": 1},
        "node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "baseline_artifact_ref": {"type": "string", "pattern": "^artifact://"},
        "baseline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "requirement_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "credential_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"}},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "artifact_ref", "sha256"],
        "properties": {
          "input_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "artifact_ref": {"type": "string", "pattern": "^artifact://"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "media_type": {"type": "string", "minLength": 3}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "action"],
        "properties": {
          "step_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "action": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "description": {"type": "string"}
        }
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "type", "expected", "observable", "evidence"],
        "properties": {
          "assertion_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
          "type": {"enum": ["visual", "text", "navigation", "accessibility", "media", "crash", "performance", "custom"]},
          "expected": {},
          "observable": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "evidence_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "teardown": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^APP-"}}
  }
}

