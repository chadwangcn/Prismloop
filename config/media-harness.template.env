# Non-secret Prismloop Media I/O Harness deployment settings (架构文档 12).
# Volc credentials are resolved by the service process from environment
# variables (VOLC_AK/VOLC_SK, credentials_source=env) injected by container
# secrets; never write keys into this file or the image.

# --- 服务监听(内网) ---
PRISMLOOP_MEDIA_LISTEN_HOST=0.0.0.0
PRISMLOOP_MEDIA_LISTEN_PORT=8787
PRISMLOOP_STATE_DB_PATH=/opt/prismloop/data/media-runs.sqlite
PRISMLOOP_ARTIFACT_STORE_REF=tos/prismloop-media

# --- Provider:Pod 裸数据注入(主线,架构文档 11 §5.1) ---
PRISMLOOP_DEVICE_PROVIDER_PROFILE=volc/pod-raw-frame
PRISMLOOP_POD_ID=<POD_ID>
PRISMLOOP_ENVIRONMENT_REF=volc/pod/<POD_ID>
PRISMLOOP_INJECTOR_PORT=18080

# --- ADB 地址续租(公网地址 TTL ~3600s,架构文档 12 P3) ---
PRISMLOOP_ADB_REFRESH_SECONDS=1800

# --- APK 产物路径(镜像内固定位置) ---
PRISMLOOP_INJECTOR_APK=/opt/prismloop/apk/media-injector.apk
PRISMLOOP_PROBE_APK=/opt/prismloop/apk/media-probe.apk

# --- 凭证(容器 Secret 注入,勿写入文件/镜像/Git) ---
# VOLC_AK=...
# VOLC_SK=...

# --- 已废弃:客户端外部源 gateway 备选路线(v2.1 起降级,勿启用) ---
# PRISMLOOP_VEPHONE_CLIENT_GATEWAY_REF=local/vephone-client-gateway
# PRISMLOOP_VEPHONE_CLIENT_GATEWAY_BASE_URL=http://127.0.0.1:8791
# PRISMLOOP_VEPHONE_STS_ROLE_TRN=
