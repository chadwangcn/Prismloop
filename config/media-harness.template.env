# Non-secret Prismloop Media I/O Harness settings.
# TOS and Volc credentials are resolved by the service process from Keychain
# or environment credential references; never write keys into this file.
PRISMLOOP_MEDIA_LISTEN_HOST=127.0.0.1
PRISMLOOP_MEDIA_LISTEN_PORT=8787
PRISMLOOP_STATE_DB_PATH=data/media-runs.sqlite
PRISMLOOP_ARTIFACT_STORE_REF=tos/prismloop-media
# The current verified-control candidate is a private client-SDK gateway. It
# stays capability_unavailable until its runtime and short-lived-token broker
# have completed a real cloud-phone Probe.
PRISMLOOP_DEVICE_PROVIDER_PROFILE=volc/client-external-frame
PRISMLOOP_VEPHONE_CLIENT_GATEWAY_REF=local/vephone-client-gateway
PRISMLOOP_VEPHONE_CLIENT_GATEWAY_BASE_URL=http://127.0.0.1:8791
# Authorization metadata only; the gateway resolves session credentials at
# runtime. Leave unset unless a scoped STS role has been provisioned.
PRISMLOOP_VEPHONE_STS_ROLE_TRN=
