{
  "acep": {
    "region": "cn-shanghai",
    "product_id": "<YOUR_PRODUCT_ID>",
    "host_id": "<YOUR_HOST_ID>",
    "shared_eip": "<YOUR_SHARED_EIP>",
    "credentials_source": "keychain",
    "ak_keychain_service": "<YOUR_AK_KEYCHAIN_SERVICE>",
    "sk_keychain_service": "<YOUR_SK_KEYCHAIN_SERVICE>"
  },
  "mua": {
    "ak": "<FROM_KEYCHAIN_OR_ENV>",
    "sk": "<FROM_KEYCHAIN_OR_ENV>",
    "region": "cn-north-1",
    "service": "ipaas",
    "version": "2023-08-01",
    "product_id": "<MUA_PRODUCT_ID_IF_DIFFERENT>"
  },
  "pods": {
    "guardian": {
      "pod_id": "<GUARDIAN_PORTRAIT_POD_ID>",
      "name": "APP-竖屏",
      "intranet_ip": "<POD_INTRANET_IP>",
      "resolution": "720x1280",
      "aosp_version": 10,
      "package_name": "com.lumi.guardian",
      "purpose": "APP 设计测试(竖屏)"
    },
    "guardian_backup": {
      "pod_id": "<GUARDIAN_LANDSCAPE_POD_ID>",
      "name": "APP-横屏",
      "intranet_ip": "<POD_INTRANET_IP>",
      "resolution": "720x1280",
      "aosp_version": 10,
      "package_name": "com.lumi.guardian",
      "purpose": "APP 设计测试(横屏,回归用)"
    },
    "k1": {
      "pod_id": "<K1_POD_ID>",
      "name": "K1-设备",
      "intranet_ip": "<POD_INTRANET_IP>",
      "resolution": "640x480",
      "aosp_version": 10,
      "package_name": "com.lumi.k1device",
      "purpose": "S6 真机/设备测试"
    },
    "k1_backup": {
      "pod_id": "<K1_BACKUP_POD_ID>",
      "name": "K1-设备(备用)",
      "intranet_ip": "<POD_INTRANET_IP>",
      "resolution": "640x480",
      "aosp_version": 10,
      "package_name": "com.lumi.k1device",
      "purpose": "备用"
    }
  },
  "pod_pairs": [
    {
      "pair_id": "pair-01",
      "guardian_pod_id": "<GUARDIAN_PORTRAIT_POD_ID>",
      "k1_pod_id": "<K1_POD_ID>",
      "purpose": "功能测试主用"
    },
    {
      "pair_id": "pair-02",
      "guardian_pod_id": "<GUARDIAN_LANDSCAPE_POD_ID>",
      "k1_pod_id": "<K1_BACKUP_POD_ID>",
      "purpose": "回归/压测"
    }
  ],
  "tos": {
    "bucket": "<YOUR_TOS_BUCKET>",
    "endpoint": "tos-s3-cn-beijing.volces.com",
    "region": "cn-beijing",
    "builds_bucket": "<YOUR_TOS_BUCKET>"
  },
  "adb": {
    "key_name": "agent-adb-key",
    "key_path": "~/.android/adbkey.pub",
    "address_refresh_ttl_sec": 3600,
    "connect_timeout": 10,
    "command_timeout": 30
  },
  "webhook": {
    "port": 8080,
    "path": "/webhook"
  },
  "sdk_bridge": {
    "enabled": false,
    "base_url": "http://localhost:9090",
    "note": "可选事件级输入扩展层,默认禁用,使用 ACEP+ADB"
  }
}
